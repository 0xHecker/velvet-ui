{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom", "vite/client"]
  },
  "include": [
    "src/router.tsx",
    "src/routes/**/*.tsx",
    "src/site/**/*.jsx",
    "src/docs/**/*.js",
    "vite.config.ts"
  ],
  "exclude": ["src/routeTree.gen.ts"]
}
